<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" alignment="CENTER_LEFT"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.Controllers.Event.AddEventController"
      stylesheets="@AddEvent.css"
      styleClass="ajouter-container">

    <Label fx:id="labelAdd" text="➕ Ajouter un Événement" styleClass="header-label"/>

    <TextField fx:id="nameField" promptText="Nom de l'événement" />
    <TextField fx:id="typeField" promptText="Type (ex: Atelier, Conférence)" />
    <DatePicker fx:id="datePicker" promptText="Date de l'événement" />
    <TextField fx:id="priceField" promptText="Prix en TND" />

    <!-- ComboBox for Location -->
    <ComboBox fx:id="locationComboBox" promptText="Select Location" prefWidth="300"/>

    <TextField fx:id="imagePathField" promptText="Chemin de l'image" />

    <Button text="🧾 Choisir une image..." onAction="#handleChooseImage" styleClass="choose-btn"/>
    <Button fx:id="addButton" text="✅ Ajouter l'événement" onAction="#handleAjouterEvent" styleClass="submit-btn"/>
</VBox>
