<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane fx:id="borderPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.Controllers.Event.ViewEventController"
            stylesheets="@ViewEvent.css"
            prefHeight="400.0" prefWidth="600.0">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="220" spacing="20" styleClass="sidebar">
            <!-- Logo and Title Container -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-title-container">
                <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                    <image>
                        <Image url="@/Images/ecodon.png" />
                    </image>
                </ImageView>
                <Label styleClass="project-title" text="Ecodon" />
            </HBox>
            <!-- Navigation Menu -->
            <VBox spacing="8" styleClass="nav-menu">
                <Button  styleClass="nav-btn" text="Profil">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/profile.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="dashboardButton" onAction="#loadHome" styleClass="nav-btn" text="Dashboard" >
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/dashboard.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button styleClass="nav-btn" text="Blog">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/blog.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button styleClass="nav-btn" text="Formation">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/study.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button styleClass="nav-btn" text="Produits">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/product.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button styleClass="nav-btn active" text="Association">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/association.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

            <!-- User Profile Section -->
            <VBox spacing="10" styleClass="user-profile">
                <ImageView fitHeight="60" fitWidth="60" styleClass="profile-img">
                    <image>
                        <Image url="@/Images/icons/profile.png" />
                    </image>
                </ImageView>
                <Label text="ADMIN" fx:id="userRoleLabel" styleClass="user-role" />
                <Button styleClass="logout-btn" text="Logout">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <image>
                                <Image url="@/Images/icons/LOGOUT.gif" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- Center Content (Posts Management) -->
    <center>
        <VBox spacing="20" styleClass="content-container">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" styleClass="header">
                <Label styleClass="header-title" text="Check our Events" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Search and Filter -->
            <HBox spacing="15" styleClass="toolbar">

            </HBox>

            <ListView fx:id="All" prefHeight="480.0" prefWidth="960.0" styleClass="publication-list" />

            <HBox fx:id="adminControls" spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10;" >
                <Button fx:id="addButton" onAction="#handleAjouter" styleClass="add-button" text="➕ Add" visible="false" />
                <Button text="↩️ Back" onAction="#handleBack" styleClass="back-btn" />
                <Button text="📍 Add Location" onAction="#handleAddLocation"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 20px; -fx-padding: 8px 12px; -fx-graphic-text-gap: 8px; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
