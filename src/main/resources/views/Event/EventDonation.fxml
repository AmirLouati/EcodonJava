<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" stylesheets="@donation.css"
            fx:controller="tn.esprit.Controllers.Event.EventDonationController"
            prefWidth="600" prefHeight="400"
            style="-fx-background-color: white; -fx-background-radius: 15;">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 5;">

            <!-- Event Title -->
            <Label fx:id="eventTitleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <!-- Donation Form -->
            <GridPane hgap="8" vgap="8" alignment="TOP_LEFT">
                <columnConstraints>
                    <ColumnConstraints prefWidth="140" halignment="RIGHT"/>
                    <ColumnConstraints prefWidth="280"/>
                </columnConstraints>

                <!-- Personal Info Section -->
                <Label text="Personal Information:" GridPane.columnSpan="2" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 13;"/>

                <Label text="First Name:" GridPane.rowIndex="1"/>
                <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Last Name:" GridPane.rowIndex="2"/>
                <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Email:" GridPane.rowIndex="3"/>
                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Phone:" GridPane.rowIndex="4"/>
                <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <!-- Address Info Section -->
                <Label text="Address Information:" GridPane.columnSpan="2" GridPane.rowIndex="5" style="-fx-font-weight: bold; -fx-font-size: 13;"/>

                <Label text="Country:" GridPane.rowIndex="6"/>
                <TextField fx:id="countryField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Address:" GridPane.rowIndex="7"/>
                <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Apartment/Suite:" GridPane.rowIndex="8"/>
                <TextField fx:id="apartmentField" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

                <Label text="Town/City:" GridPane.rowIndex="9"/>
                <TextField fx:id="townField" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                <Label text="State/Province:" GridPane.rowIndex="10"/>
                <TextField fx:id="stateField" GridPane.columnIndex="1" GridPane.rowIndex="10"/>

                <Label text="Postal Code:" GridPane.rowIndex="11"/>
                <TextField fx:id="postalCodeField" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

                <!-- Donation Details -->
                <Label text="Donation Details:" GridPane.columnSpan="2" GridPane.rowIndex="12" style="-fx-font-weight: bold; -fx-font-size: 13;"/>

                <Label text="Amount (TND):" GridPane.rowIndex="13"/>
                <TextField fx:id="donationAmountField" GridPane.columnIndex="1" GridPane.rowIndex="13"/>

                <Label text="Donation Type:" GridPane.rowIndex="14"/>
                <ComboBox fx:id="donationTypeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="14"/>

                <Label text="Payment Method:" GridPane.rowIndex="15"/>
                <ComboBox fx:id="paymentMethodComboBox" GridPane.columnIndex="1" GridPane.rowIndex="15"/>

                <Label text="Notes:" GridPane.rowIndex="16"/>
                <TextArea fx:id="orderNotesArea" GridPane.columnIndex="1" GridPane.rowIndex="16" prefHeight="40"/>
            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                <Button fx:id="donateButton" text="Donate Now" onAction="#handleDonate"
                        style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Cancel" onAction="#closePopup"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>