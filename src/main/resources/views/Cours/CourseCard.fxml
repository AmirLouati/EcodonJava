<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Controllers.Cours.CourseCardController"
      prefWidth="300.0" prefHeight="200.0"
      style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Titre du cours -->
    <Label fx:id="courseNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <!-- Description du cours -->
    <Label fx:id="descriptionLabel" wrapText="true" />

    <!-- Formation associée -->
    <Label fx:id="formationLabel" style="-fx-font-style: italic;" />

    <!-- Boutons Actions -->
    <HBox spacing="10">
        <Button fx:id="editButton" text="Modifier" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
        <Button fx:id="deleteButton" text="Supprimer" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
        <Button fx:id="generateQuizButton" text="Générer Quiz" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
    </HBox>
</VBox>